{
  "name": "vibevault",
  "productName": "VibeVault",
  "version": "0.1.0",
  "description": "Media manager local-first e portatile per foto, video e GIF su SSD",
  "private": true,
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "electron-vite build && vitest run",
    "dist:portable": "electron-vite build && electron-builder --win portable --x64",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "test:only": "vitest run",
    "dist:ssd": "electron-vite build && electron-builder --dir && node scripts/make-ssd-bundle.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "zustand": "^5.0.15"
  },
  "author": "VibeVault",
  "license": "UNLICENSED"
}
